# Copy to .env (git-ignored) or export these variables. NEVER commit a real key.
# Free option (no card): create a key at https://console.groq.com/keys
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Same model for both conditions of the evaluation (LLM-only and KG-grounded)
CRASH_MODEL=openai/gpt-oss-120b
CRASH_TEMPERATURE=0
CRASH_MAX_TOKENS=1200
CRASH_REASONING_EFFORT=low
# Free tier allows 8000 tokens/minute: the client waits automatically to stay under this budget
CRASH_TPM=7000
# Max result rows passed to the LLM as context
CRASH_CONTEXT_ROWS=30
# Other OpenAI-compatible providers: change the three variables above, e.g.
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  CRASH_MODEL=gemini-2.5-flash
#   xAI:    LLM_BASE_URL=https://api.x.ai/v1  CRASH_MODEL=<grok model>   (paid/credit-based)
# Free tier also has a DAILY limit (about 200,000 tokens for gpt-oss-120b, roughly 40 questions). Optional automatic fallback when it is used up
# (a different, weaker model; leave empty for the evaluation so that both conditions use one model):
# CRASH_FALLBACK_MODEL=openai/gpt-oss-20b
